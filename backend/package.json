{
  "name": "simple-booking-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Бэкенд «Запись на звонок» — реализация по контракту api/openapi/openapi.yaml",
  "main": "dist/server.js",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi/openapi.yaml -o src/api/schema.d.ts",
    "build": "npm run gen:api && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "oxlint",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.1",
    "luxon": "^3.7.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.2.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.0"
  }
}
