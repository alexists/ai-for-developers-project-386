# Куда dev-сервер Vite проксирует запросы /api.
# Локальный бэкенд:           http://127.0.0.1:8080
# Prism (мок по контракту):   http://127.0.0.1:4010
#
# На Windows именно 127.0.0.1, а не localhost: Node-серверы слушают IPv4,
# и по имени localhost прокси может уйти на ::1 и не найти бэкенд.
VITE_API_TARGET=http://127.0.0.1:8080
